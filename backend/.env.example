# Set these on the API host (Railway, Render, or Fly).
# For local dev you can keep the same names in the repo-root .env.local.

PORT=4000
API_URL=https://your-api.example.com
FRONTEND_URL=https://your-app.vercel.app

# JWT signing key — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth. Redirect URI: https://your-api.example.com/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase (Project Settings → API). Service role is server only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
