# Copy to .env.local at this repo root (not inside ui/ or backend/).
# The UI and the backend both load this file.
# Hosting steps: docs/hosting.md

# UI
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# JWT signing key — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: http://localhost:4000/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase (Project Settings → API). The service_role key is secret: server only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
